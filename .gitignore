# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google service-account keys (secrets — never commit)
*-php-client-*.json
*.serviceaccount.json
gsc-service-account.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local cover/source image drops (the real assets live in public/images)
/*.png
/*.svg
/*.jpg
/*.jpeg
/images/

# Internal source material — NEVER commit, this repository is public.
# The project register carries client receivables, named security incidents,
# white-label end clients belonging to a partner, and internal delivery
# criticism. Only aggregates derived from it belong in lib/portfolio-data.ts.
/appycodes-case-studies/
/appycodes-pitch-deck.*
# The sector rules match on client names, so the filled-in table is a client
# list. Commit domain-rules.example.js instead.
/scripts/domain-rules.js

# Scratch assets and source files kept locally, never shipped.
/files-do-not-commit/
